<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Equivalente de checker.timer + checker.service para macOS, que no tiene
  systemd. Ver DESPLIEGUE.md, alojamiento B.

  SUSTITUYE "USUARIO" por el nombre de usuario real antes de instalarlo:
  launchd exige rutas absolutas y no admite ~.

  StartInterval esta en segundos. 180 = 3 minutos; una ronda de 10 articulos
  tarda ~55 s, asi que queda margen de sobra. Para cambiarlo, edita el numero
  y recarga con launchctl unload + load (DESPLIEGUE.md). launchd no solapa
  ejecuciones: si una ronda sigue viva al llegar el siguiente disparo, lo
  difiere.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.zara-restock.checker</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/USUARIO/zara-restock/checker-mac.sh</string>
  </array>

  <key>StartInterval</key>
  <integer>180</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/USUARIO/Library/Logs/zara-restock.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/USUARIO/Library/Logs/zara-restock.log</string>
</dict>
</plist>
