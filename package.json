{
  "name": "zara-restock",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "db:local": "wrangler d1 execute zara-restock --local --file=schema.sql",
    "db:remote": "wrangler d1 execute zara-restock --remote --file=schema.sql",
    "logs": "wrangler tail"
  },
  "devDependencies": {
    "wrangler": "^4",
    "vitest": "^3"
  },
  "dependencies": {
    "puppeteer": "^25"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "puppeteer@25.3.0": true,
    "sharp@0.34.5": true,
    "workerd@1.20260721.1": true
  }
}
