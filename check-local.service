[Unit]
Description=zara-restock: comprobacion periodica de disponibilidad en Zara
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/zara-restock
Environment=WORKER_URL=https://zara-restock.restock-wendy.workers.dev
ExecStart=/usr/bin/node check-local.js
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
